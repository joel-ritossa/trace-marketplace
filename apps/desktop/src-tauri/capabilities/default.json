{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main-window capability: tray, settings store, folder watch (read-only fs), native notifications, CORS-free HTTP to the API/Supabase, and opening web links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:tray:allow-new",
    "core:tray:allow-get-by-id",
    "core:tray:allow-set-title",
    "core:tray:allow-set-tooltip",
    "core:app:allow-default-window-icon",
    "store:default",
    "dialog:default",
    "notifications:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://**" }, { "url": "https://**" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "https://*:*" },
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-stat",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
