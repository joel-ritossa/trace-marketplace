# Real benchmark trace data pulled by `make dev-dataset` — never committed;
# committed fixtures are synthetic (fixtures/).
devdata/

# Experiment data dirs (real benchmark traces, embeddings) — never committed;
# experiment scripts/findings in sandbox/ are tracked. Raw run outputs derived
# from real traces stay out; the summary.md compression is tracked.
sandbox/**/data/
sandbox/**/results/**/*.json
!sandbox/**/results/**/meta.json

# Terraform (machine-local state, plugins, and var values)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars

# Local tooling
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
infra/tfplan
