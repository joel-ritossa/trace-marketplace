# Copy to .env. Values below match the local Supabase stack (`supabase start`);
# confirm with `supabase status` if anything differs.

# Browser-facing (inlined into the web build)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# The local development anon key (same for every local Supabase stack):
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_API_URL=http://localhost:8000
# Max files accepted per web dropzone batch (each file is its own upload;
# 50 stays under the 60/min per-user upload rate limit)
NEXT_PUBLIC_UPLOAD_MAX_FILES=50

# Host port for the web app (change if 3000 is taken locally)
WEB_PORT=3000

# Local Supabase stack ports — must match supabase/config.toml; used by
# docker-compose.yml to build host.docker.internal URLs for containers.
SUPABASE_API_PORT=55321
SUPABASE_DB_PORT=55322

# API + worker (read via pydantic-settings; docker-compose.yml overrides these
# for containers, and real env vars always beat file values — in cloud hosting,
# inject them as environment variables instead of shipping a file)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
REDIS_URL=redis://127.0.0.1:56379/0
SUPABASE_URL=http://127.0.0.1:55321
# The local development service_role key (same for every local Supabase stack);
# grants storage/DB access to the API and worker. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
WEB_ORIGIN=http://localhost:3000
# Mounts /v1/dev/* (worker ping demo) and the X-Fault injection header.
# Defaults to false; local opt-in only.
DEV_ROUTES=true

# Logging (API + worker): JSON lines on stdout and in ./logs/<service>.log
# (docker-compose.yml mounts ./logs and sets LOG_FILE per service), each line
# carrying a correlation id that follows an upload from the HTTP request
# through ingest → analyze → match (`grep <id> logs/*.log`). Shipping to
# CloudWatch et al. means collecting stdout — no code change.
LOG_LEVEL=INFO
# Recent records also kept in an in-process ring buffer (app/obs.py).
LOG_BUFFER_RECORDS=1000
# File sink for host-run processes (compose containers get theirs from
# docker-compose.yml); unset = stdout only.
# LOG_FILE=logs/api.log

# Analysis (stage 2). Read by the worker (docker-compose.yml passes these
# through to containers when set) and the offline runner
# (`python -m app.cli.analyze`); none are required — these are the defaults.
# Trace rendering: budget in ~tokens (chars/4 heuristic), per-field caps in
# chars, and how many final steps are always kept (must-haves).
ANALYSIS_RENDER_BUDGET_TOKENS=15000
ANALYSIS_RENDER_FINAL_STEPS=8
ANALYSIS_RENDER_TOOL_FIELD_CAP_CHARS=2000
ANALYSIS_RENDER_CONVERSATION_CAP_CHARS=8000

# Loop detection: how many exact repeats / identical results count as a loop.
ANALYSIS_LOOP_N=3

# Outcome judge. The model string routes through litellm (provider/model);
# the matching provider key uses litellm's conventional env var name
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, …) — put real keys in .env.local for
# host-run tools (offline runner); the compose worker reads .env only.
# No key configured = LLM analysis skips cleanly (zero-external-flow mode).
ANALYSIS_JUDGE_MODEL=openai/gpt-5-mini
# OPENAI_API_KEY=sk-…
# Self-consistency votes per composed call (1 = trust the model's
# self-reported confidence), the strict-majority consensus threshold, and
# the review-routing confidence threshold (outcome + task_category).
# 5 votes: one defector survives the 0.7 threshold (4/5) instead of
# routing (2/3) — measured at half the routing rate for flat accuracy.
ANALYSIS_JUDGE_VOTES=5
ANALYSIS_JUDGE_CONSENSUS=0.5
ANALYSIS_CONFIDENCE_THRESHOLD=0.7

# Quality metrics (family 3): which metrics a run executes — the default is
# the full locked catalog (critics yield booleans; faithfulness and
# goal_accuracy are RAGAS-backed 0–1 scores). Metrics share the judge's
# model and key. Critic self-consistency votes default to 1 (metrics never
# route to review, so extra votes are pure cost).
ANALYSIS_METRICS=hallucination,helpfulness,harmfulness,coherence,relevancy,faithfulness,goal_accuracy
ANALYSIS_CRITIC_VOTES=1

# Similar behavior (docs/proposals/similar-behavior.md): the per-trace
# embedding over the judge rendering. Same key conventions and keyless-skip
# as the judge. The budget re-truncates the rendering to fit the embedding
# window with headroom (the chars→tokens heuristic undercounts JSON-heavy
# content; over-window inputs fail permanently). The vector dimension is
# fixed by the migration — a model swap needs a migration + re-embed, not
# just this flip.
ANALYSIS_EMBEDDING_MODEL=openai/text-embedding-3-small
ANALYSIS_EMBEDDING_BUDGET_TOKENS=6000

# Sync CLI (apps/cli, `trace-sync`). Both overridable per-run with
# --api-url / --api-key; the key is minted on /settings (upload-only scope).
TRACE_API_URL=http://localhost:8000
# TRACE_API_KEY=tmk_…

# Machine-local secrets/overrides belong in .env.local (gitignored, wins over .env).
