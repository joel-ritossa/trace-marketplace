# Copy to .env. Values below match the local Supabase stack (`supabase start`);
# confirm with `supabase status` if anything differs.

# Browser-facing (inlined into the web build)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# The local development anon key (same for every local Supabase stack):
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host port for the web app (change if 3000 is taken locally)
WEB_PORT=3000

# Local Supabase stack ports — must match supabase/config.toml; used by
# docker-compose.yml to build host.docker.internal URLs for containers.
SUPABASE_API_PORT=55321
SUPABASE_DB_PORT=55322

# API + worker (read via pydantic-settings; docker-compose.yml overrides these
# for containers, and real env vars always beat file values — in cloud hosting,
# inject them as environment variables instead of shipping a file)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
REDIS_URL=redis://127.0.0.1:56379/0
SUPABASE_URL=http://127.0.0.1:55321
# The local development service_role key (same for every local Supabase stack);
# grants storage/DB access to the API and worker. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
WEB_ORIGIN=http://localhost:3000
# Mounts /v1/dev/* (worker ping demo) and the X-Fault injection header.
# Defaults to false; local opt-in only.
DEV_ROUTES=true

# Analysis (stage 2). Read by the worker and the offline runner
# (`python -m app.cli.analyze`); none are required — these are the defaults.
# Trace rendering: budget in ~tokens (chars/4 heuristic), per-field caps in
# chars, and how many final steps are always kept (must-haves).
ANALYSIS_RENDER_BUDGET_TOKENS=15000
ANALYSIS_RENDER_FINAL_STEPS=8
ANALYSIS_RENDER_TOOL_FIELD_CAP_CHARS=2000
ANALYSIS_RENDER_CONVERSATION_CAP_CHARS=8000

# Machine-local secrets/overrides belong in .env.local (gitignored, wins over .env).
